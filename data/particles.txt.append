glitch_drip {
	#system properties
	movieclip glitchdrip
	max_particles 250
	layer 1
	livebounds [-10, 64, -10, 42]
	batched false
	
	#emitter properties
	emit_rate [4, 12]
	emit_amount [1, 2]
	emit_direction [0, 1]
	emit_spread 45
	emit_box [1.5, .5]
	emit_offset [0,.5]
	
	#particle animation properties
