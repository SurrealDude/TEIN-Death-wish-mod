crystal_shards {
    #system TestParticle
    movieclip CrystalShard
    max_particles 300
    layer 1
    livebounds [-10, 64, -10, 42]
    prewarm [20,6]
    batched true
    
    #emitter properties
    emit_rate 10
    emit_amount 3
    emit_direction [0, 1]
    emit_spread 0
    emit_box [54, 32]      #54 for "level width", 32 for "level height"    
    emit_offset [27,16]   #27,16 for middle of the level. 0,0 for bottom left. 54,32 for upper right. this one sets it as a strip at the top 
    
    #particle animation properties
    particle_lifetime [2,5]
    initial_speed [0, 0]
    initial_rotation [0,360]
    rotation_speed 40
    force [0, 0]
    friction 1
    size_start [1.2,3]
    size_end [.05,.3]
    alpha_start [.1, .5]
    alpha_end 1
    face_moving_direction false
    speed_scale 0
    inherit_speed 0
    tags []
}

drillblock_destroy {
    movieclip Rock2
    max_particles 500
    layer 2
    livebounds [-10, 64, -10, 42]
    prewarm 0
    batched false
    
    #emitter properties
    emit_rate 100
    emit_amount 10
    emit_direction [0, 1]
    emit_spread 360
    emit_box [3, 1]      #54 for "level width", 32 for "level height"    
    emit_offset [0,-2]   #27,16 for middle of the level. 0,0 for bottom left. 54,32 for upper right. this one sets it as a strip at the top 
    
    #particle animation properties
    particle_lifetime [.5, 1.5]
    initial_speed [3, 6]
    initial_rotation [0,360]
    rotation_speed [-1080, 1080]
    force [0, -30]
    friction 1
    size_start 1
    size_end 1
    alpha_start 5
    alpha_end 0
    face_moving_direction false
    speed_scale 0
    inherit_speed 1
    tags [dampened_bounce_tile]
}

fallleaves {
    #system TestParticle
    movieclip FallLeaf
    max_particles 100
    layer 1
    livebounds [-10, 64, -10, 42]
