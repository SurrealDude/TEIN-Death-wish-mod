# DEATH WISH
fall_leaves {
    #system TestParticle
    movieclip FallLeaf
    max_particles 100
    layer 1
    livebounds [-10, 64, -10, 42]
    prewarm [20,48]
    batched false
    
    #emitter properties
    emit_rate 4
    emit_amount 1
    emit_direction [1, 0]
    emit_spread 20
    emit_box [0, 64]      #54 for "level width", 32 for "level height"    
    emit_offset [-10,32]   #27,16 for middle of the level. 0,0 for bottom left. 54,32 for upper right. this one sets it as a strip at the top 
    
    #particle animation properties
    particle_lifetime 40
    initial_speed [2, 5]
    initial_rotation [0,360]
    rotation_speed [-200, 200]
    force [0, -.1]
    friction 1
    size_start [0.75,1.50]
    size_end 1
    alpha_start 1
    alpha_end 1
    face_moving_direction false
    speed_scale 0
    inherit_speed 0
    tags []
}
fall_leaves_red {
    inherit fall_leaves
	layer 0
    movieclip FallLeafRed
}
fall_leaves_yellow {
    inherit fall_leaves
	layer 0
    movieclip FallLeafYellow
}
rising_wisp {
    #system properties
    movieclip ShootingStar
    max_particles 500
    layer 1
    livebounds [-10, 64, -10, 42]
    batched false
    
    #emitter properties
    emit_rate [1, 3]
    emit_amount [0, 1]
    emit_direction [0, 1]
    emit_spread 90
    emit_box [0.5, 0]      #54 for "level width", 32 for "level height"    
    emit_offset [0,-.5]   #27,16 for middle of the level. 0,0 for bottom left. 54,32 for upper right. this one sets it as a strip at the top 
    
    #particle animation properties
    particle_lifetime 8
    initial_speed [4, 8]
    initial_rotation 0
    rotation_speed 0
    force [0, 7]
    friction [.95, .959]
    size_start [0.8, 2]
    size_end  [0.8, 2]
    alpha_start [0.25, 1] #more than one alpha just means its full alpha for longer before it fades out
    alpha_end 0
    face_moving_direction false
    speed_scale 0
    inherit_speed 1
    tags []
}
shooting_star {
    #system TestParticle
    movieclip ShootingStar
    max_particles 200
    layer 3
    livebounds [-32, 64, -10, 50]
    prewarm [20,48]
    batched false
    
    #emitter properties
    emit_rate 30
    emit_amount 2
    emit_direction [0, 0]
    emit_spread 20
    emit_box [54, 32]      #54 for "level width", 32 for "level height"    
    emit_offset [27,16]   #27,16 for middle of the level. 0,0 for bottom left. 54,32 for upper right. this one sets it as a strip at the top 
    
    #particle animation properties
    particle_lifetime 3
    initial_speed 0
    initial_rotation [0,360]
    rotation_speed [-200, 200]
    force [0, 0]
    friction 1
    size_start [.5,1.5]
    size_end [.5,1.5]
    alpha_start 1
    alpha_end 0
    face_moving_direction false
    speed_scale 0
    inherit_speed 0
    tags []
}

# ROOT C -> D -> E
left_bubbles {
	inherit bubbles
	emit_amount [0, 1]
    emit_direction [-1, 0]
	emit_spread 10
    initial_speed [6, 8]
}
waste_down {
    #system properties
    movieclip Gibs
    max_particles 500
    layer 2
    livebounds [-10, 64, -10, 42]
    batched false
    
    #emitter properties
    emit_rate 20
    emit_amount 3
    emit_direction [0, -1]
    emit_spread 0
    emit_box [1, 0]      #54 for "level width", 32 for "level height"    
    emit_offset [0,.5]   #27,16 for middle of the level. 0,0 for bottom left. 54,32 for upper right. this one sets it as a strip at the top 
    
    #particle animation properties
    particle_lifetime [.5, 2]
    initial_speed [5, 15]
    initial_rotation [0, 360]
    rotation_speed [-1080, 1080]
   force [0,-30]
    friction 1
    size_start 1.2
    size_end .9
    alpha_start 5
    alpha_end 0
    face_moving_direction false
    speed_scale 0
    inherit_speed 1
    tags [collide_tile, collide_water, player_bounce_waterfall]
}
