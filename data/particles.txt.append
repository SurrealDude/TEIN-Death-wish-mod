    emit_spread 20
    emit_box [0, 64]      #54 for "level width", 32 for "level height"    
    emit_offset [-10,32]   #27,16 for middle of the level. 0,0 for bottom left. 54,32 for upper right. this one sets it as a strip at the top 
    
    #particle animation properties
    particle_lifetime 40
    initial_speed [2, 5]
    initial_rotation [0,360]
    rotation_speed [-200, 200]
    force [0, -.1]
    friction 1
    size_start [0.75,1.50]
    size_end 1
    alpha_start 1
    alpha_end 1
    face_moving_direction false
    speed_scale 0
    inherit_speed 0
    tags []
}

flowing_electricity {
    #system properties
    movieclip FlowingElectricity
    max_particles 500
    layer 1
    livebounds [-10, 64, -10, 42]
    batched false
    
    #emitter properties
    emit_rate [1, 3]
    emit_amount [0, 1]
    emit_direction [0, 0]
    emit_spread 90
    emit_box [.5, 0]      #54 for "level width", 32 for "level height"    
    emit_offset [0,.5]   #27,16 for middle of the level. 0,0 for bottom left. 54,32 for upper right. this one sets it as a strip at the top 
    
    #particle animation properties
    particle_lifetime 1
    initial_speed [4, 8]
    initial_rotation [0, 1]
    rotation_speed 0
    force [0, 0]
    friction 1
    size_start [0.6, 1]
    size_end  [0.6, 1]
    alpha_start [0.25, 1] #more than one alpha just means its full alpha for longer before it fades out
    alpha_end 0
    face_moving_direction false
    speed_scale 0
    inherit_speed 1
    tags []
}

glitch_drip {
	#system properties
	movieclip glitchdrip
	max_particles 250
	layer 1
	livebounds [-10, 64, -10, 42]
	batched false
	
	#emitter properties
	emit_rate [4, 12]
	emit_amount [1, 2]
	emit_direction [0, 1]
	emit_spread 45
	emit_box [1.5, .5]
	emit_offset [0,.5]
	
	#particle animation properties
	particle_lifetime 5
	initial_speed 5
	initial_rotation 0
	rotation_speed 0
	force [0, 5]
	friction 1
	size_start [1,1.5]
	size_end 1
	alpha_start 1
	alpha_end 1
	face_moving_direction true
	speed_scale 0.12
	inherit_speed 0
	tags [collide_tile, collide_water]
}

