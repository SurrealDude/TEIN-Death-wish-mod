steam {
    #system properties
    movieclip TestParticle2
    max_particles 500
    layer 6
    livebounds [-10, 64, -10, 42]
    batched false
    
    #emitter properties
    emit_rate 40
    emit_amount [0,1]
    emit_direction [0, 1]
    emit_spread 90
    emit_box [1, 0]      #54 for "level width", 32 for "level height"    
    emit_offset [0,-.5]   #27,16 for middle of the level. 0,0 for bottom left. 54,32 for upper right. this one sets it as a strip at the top 
    
    #particle animation properties
    particle_lifetime [2,3.5]
    initial_speed [1, 5]
    initial_rotation 0
    rotation_speed 0
    force [0, 7]
    friction [.95, .959]
    size_start [4,8]
    size_end  [0, .75]
    alpha_start .5 #more than one alpha just means its full alpha for longer before it fades out
    alpha_end 0
    face_moving_direction true
    speed_scale 0
    inherit_speed 1
    tags [player_push]
}
cold_waterfall {
    inherit waterfall_parts
	movieclip WaterParticle
	alpha_start .8
    emit_offset [0, .3]
}
cold_waterfall_splash {
    inherit waterfall_splash_top
	movieclip WaterParticle
	alpha_start .8
}
foggy_mist {
    #system properties
    movieclip TestParticle2
    max_particles 1000
    layer 5
    livebounds [-30, 84, -30, 62]
    prewarm [20,12]
    batched true
    
    #emitter properties
    emit_rate 60
    emit_amount 5
    emit_direction [0, 1]
    emit_spread 20
    emit_box [64, 42]      #54 for "level width", 32 for "level height"    
    emit_offset [27,16]   #27,16 for middle of the level. 0,0 for bottom left. 54,32 for upper right. this one sets it as a strip at the top 
    
    #particle animation properties
    particle_lifetime [1,2]
    initial_speed [0,15]
    initial_rotation 0
    rotation_speed 0
    force [0, 10]
    friction .99
    size_start [.1]
    size_end  [200,400]
    alpha_start .1 #more than one alpha just means its full alpha for longer before it fades out
    alpha_end 0
    face_moving_direction true
    speed_scale 0
    inherit_speed 0
    tags [player_push]
}
